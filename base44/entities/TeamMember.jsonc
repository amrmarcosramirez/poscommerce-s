{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nombre completo del miembro del equipo"
    },
    "email": {
      "type": "string",
      "description": "Email del miembro"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "manager",
        "cashier"
      ],
      "default": "cashier",
      "description": "Rol: admin (total), manager (gesti\u00f3n), cashier (solo POS)"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono"
    },
    "store_id": {
      "type": "string",
      "description": "ID de la tienda asignada (opcional)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Si el usuario est\u00e1 activo"
    },
    "invitation_status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "expired"
      ],
      "default": "pending",
      "description": "Estado de la invitaci\u00f3n"
    },
    "invited_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de invitaci\u00f3n"
    }
  },
  "required": [
    "full_name",
    "email",
    "role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}